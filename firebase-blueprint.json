{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and notification preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["student", "educator", "manager", "operations", "admin"], "maxLength": 32 },
        "organization": { "type": "string", "maxLength": 150 },
        "reminderPreferences": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "createdAt", "updatedAt"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Uploaded or pasted source document with Gemini extraction and hashes for duplicate detection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "type": "string", "maxLength": 80 },
        "sourceType": { "type": "string", "enum": ["pdf", "image", "txt", "text"], "maxLength": 20 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "normalizedHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contentExcerpt": { "type": "string", "maxLength": 4000 },
        "analysis": { "type": "object" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "sourceType", "fileHash", "normalizedHash", "createdAt", "updatedAt"]
    },
    "WorkflowRecord": {
      "title": "WorkflowRecord",
      "description": "AI-generated or manual workflow with human approval lifecycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "documentId": { "type": "string", "maxLength": 128 },
        "documentTitle": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 80 },
        "objective": { "type": "string", "maxLength": 1000 },
        "sourceMethod": { "type": "string", "enum": ["document", "text", "manual"], "maxLength": 20 },
        "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "in_progress", "completed", "rejected", "archived"], "maxLength": 32 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "maxLength": 20 },
        "responsibleRoles": { "type": "array" },
        "completionConditions": { "type": "array" },
        "requiredApprovals": { "type": "array" },
        "history": { "type": "array" },
        "taskCount": { "type": "number" },
        "completedTaskCount": { "type": "number" },
        "progress": { "type": "number" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "sourceMethod", "status", "priority", "progress", "createdAt", "updatedAt"]
    },
    "TaskRecord": {
      "title": "TaskRecord",
      "description": "Actionable task belonging to a workflow.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workflowId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workflowTitle": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "assignedUser": { "type": "string", "maxLength": 150 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "maxLength": 20 },
        "startDate": { "type": "string", "maxLength": 40 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "under_review", "completed", "overdue"], "maxLength": 32 },
        "dependencies": { "type": "array" },
        "orderIndex": { "type": "number" },
        "reminderDate": { "type": "string", "maxLength": 40 },
        "reminderTime": { "type": "string", "maxLength": 20 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "workflowId", "title", "priority", "status", "orderIndex", "createdAt", "updatedAt"]
    },
    "CalendarEventRecord": {
      "title": "CalendarEventRecord",
      "description": "Calendar deadline, milestone, or reminder event.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workflowId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "eventDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "eventTime": { "type": "string", "maxLength": 20 },
        "eventType": { "type": "string", "enum": ["deadline", "milestone", "event", "reminder"], "maxLength": 32 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "eventDate", "eventType", "priority", "createdAt", "updatedAt"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "In-app reminder and workflow notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "type": { "type": "string", "enum": ["deadline", "overdue", "approval", "assignment", "summary", "system"], "maxLength": 32 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "scheduledFor": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "Audit log of user workflow and document actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 500 },
        "entityType": { "type": "string", "enum": ["document", "workflow", "task", "calendar", "integration"], "maxLength": 32 },
        "entityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action", "entityType", "createdAt"]
    },
    "IntegrationRecord": {
      "title": "IntegrationRecord",
      "description": "User-configured external integration or webhook settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provider": { "type": "string", "enum": ["google_calendar", "gmail", "slack", "microsoft_teams", "webhooks", "n8n"], "maxLength": 40 },
        "status": { "type": "string", "enum": ["not_connected", "configured", "connected"], "maxLength": 32 },
        "webhookUrl": { "type": "string", "maxLength": 500 },
        "configNotes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "provider", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles and notification preferences."
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/DocumentRecord" },
      "description": "Analyzed documents owned by authenticated users."
    },
    "/workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/WorkflowRecord" },
      "description": "Workflows owned by authenticated users."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskRecord" },
      "description": "Tasks linked to user workflows."
    },
    "/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEventRecord" },
      "description": "Calendar events and deadlines owned by users."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "In-app notifications for users."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityRecord" },
      "description": "Workspace activity log entries."
    },
    "/integrations/{integrationId}": {
      "schema": { "$ref": "#/entities/IntegrationRecord" },
      "description": "Configured external integrations and webhooks."
    }
  }
}
